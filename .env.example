# Copy to .env (git-ignored) and fill in ONE provider. ti2dac reads it automatically;
# variables already set in your shell take precedence. Never commit the real .env.

# --- Claude (Anthropic): default provider. Key from console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=

# --- Gemini (Google AI Studio): uncomment both lines to use it instead.
#     Use a key from a project with billing enabled; free-tier keys are for light testing only.
# GEMINI_API_KEY=
# TI2DAC_PROVIDER=gemini

# --- Optional
# TI2DAC_NO_AI=1                 # deterministic mode, no AI calls at all
# TI2DAC_WEB_USER= / TI2DAC_WEB_PASSWORD=   # prefer `ti2dac user add` for web logins
